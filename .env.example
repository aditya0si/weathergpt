# WeatherGPT Environment Configuration

# Server Settings
WEATHERGPT_HOST=0.0.0.0
WEATHERGPT_PORT=8000
WEATHERGPT_DEBUG=false
WEATHERGPT_LOG_LEVEL=INFO

# Default Language (en, hi, as)
WEATHERGPT_DEFAULT_LANGUAGE=en

# LLM Provider Configuration (Optional - embedded deterministic agent is used if keys are not provided)
# Available providers: "hybrid", "openai", "gemini", "groq", "mock"
WEATHERGPT_LLM_PROVIDER=hybrid
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.1-70b-versatile

# Weather & Geocoding API Endpoints
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
OPENMETEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1
IMD_BULLETIN_RSS_URL=https://mausam.imd.gov.in/responsive/all_india_bulletin.php
IMD_WARNING_URL=https://internal.imd.gov.in/pages/press_release_mausam.php
NOAA_GFS_URL=https://nomads.ncep.noaa.gov/dods/gfs_0p25

# Performance & Rate Limits
CACHE_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=10.0
